{
  "name": "openledmapper-desktop",
  "productName": "openLedMapper",
  "version": "0.8.3",
  "description": "openLedMapper desktop app: the interface in its own window, with the Art-Net bridge inside",
  "license": "GPL-3.0",
  "author": "nouled studio",
  "repository": "github:nouled-studio/openLEDmapper",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "studio.nouled.openledmapper",
    "productName": "openLedMapper",
    "copyright": "GPL-3.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/openledmapper-bridge",
        "to": "bridge"
      }
    ],
    "mac": {
      "target": "dir",
      "icon": "../icons/openledmapper.icns",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "target": "nsis",
      "icon": "../icons/openledmapper.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "openLedMapper-${version}-windows-setup.${ext}"
    }
  }
}
