{
  "name": "noupix-desktop",
  "productName": "nouPix",
  "version": "1.2.0",
  "description": "nouPix desktop app: the interface in its own window, with the Art-Net bridge inside",
  "license": "AGPL-3.0-only",
  "author": "nouled studio",
  "repository": "github:nouled-studio/openLEDmapper",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "studio.nouled.noupix",
    "productName": "nouPix",
    "copyright": "Copyright © 2026 nouled studio. AGPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/noupix-bridge",
        "to": "bridge"
      }
    ],
    "mac": {
      "target": "dir",
      "icon": "../icons/noupix.icns",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "studio.nouled.noupix.project",
            "UTTypeDescription": "nouPix project",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeIconFile": "noupix.icns",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "noupix"
              ],
              "public.mime-type": [
                "application/x-noupix-project"
              ]
            }
          },
          {
            "UTTypeIdentifier": "studio.nouled.noupix.package",
            "UTTypeDescription": "nouPix package",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeIconFile": "noupixpkg.icns",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "noupixpkg"
              ],
              "public.mime-type": [
                "application/x-noupix-package"
              ]
            }
          }
        ]
      }
    },
    "win": {
      "target": "nsis",
      "icon": "../icons/noupix.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "nouPix-${version}-windows-setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "noupix",
        "name": "nouPix project",
        "description": "nouPix project",
        "role": "Editor",
        "icon": "noupix",
        "mimeType": "application/x-noupix-project",
        "rank": "Owner"
      },
      {
        "ext": "noupixpkg",
        "name": "nouPix package",
        "description": "nouPix package (a project and its media)",
        "role": "Editor",
        "icon": "noupixpkg",
        "mimeType": "application/x-noupix-package",
        "rank": "Owner"
      }
    ]
  }
}
